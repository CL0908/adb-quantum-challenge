{
  "name": "adb-quantum-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data": "cd .. && PYTHONPATH=. python -m src.viz.web_precompute && PYTHONPATH=. python -m src.viz.export_web_data",
